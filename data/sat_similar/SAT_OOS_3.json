      "type": "solve_rational_equation_for_variable",
      "question": "If 6/(a - 3) = 24/y, and y != 0 where a != 3, what is y in terms of a?",
      "choices": {
        "A": "24a - 72",
        "B": "4a + 12",
        "C": "6a - 18",
        "D": "4a - 12",
        "E": "(1/4)a - 3/4"
      },
      "answer": "D",
      "explanation": "Cross-multiplying gives 6y = 24(a - 3), so y = 4(a - 3) = 4a - 12."
    },
